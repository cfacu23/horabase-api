# Base de datos local (debe coincidir con DB_PASSWORD de la API)
DB_URL=jdbc:postgresql://localhost:5432/horabase
DB_USERNAME=horabase
DB_PASSWORD=replace-with-a-local-password

# Generar con: openssl rand -base64 32
JWT_SECRET=replace-with-a-base64-secret-of-at-least-32-bytes
JWT_ISSUER=horabase-api
JWT_EXPIRATION_MINUTES=60

# Bootstrap inicial. Activar solo en el primer arranque y luego desactivar.
HORABASE_BOOTSTRAP_ENABLED=false
HORABASE_BOOTSTRAP_BUSINESS_NAME=Comercio inicial
HORABASE_BOOTSTRAP_TAX_ID=replace-with-tax-id
HORABASE_BOOTSTRAP_ADMIN_DOCUMENT=replace-with-document
HORABASE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
HORABASE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

ATTENDANCE_SHIFT_MATCH_WINDOW_MINUTES=240
PASSWORD_RESET_EXPIRATION_MINUTES=30
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

MAIL_FROM=no-reply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
