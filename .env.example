# Puertos publicados por Docker. Cambiarlos si otro servicio local los ocupa.
POSTGRES_PORT=5432
API_PORT=8080
FRONTEND_PORT=3000

# PostgreSQL
DB_NAME=horabase
DB_URL=jdbc:postgresql://localhost:5432/horabase
DB_USERNAME=horabase
DB_PASSWORD=replace-with-a-local-password

# Generar con: openssl rand -base64 32
JWT_SECRET=replace-with-a-base64-secret-of-at-least-32-bytes
JWT_ISSUER=horabase-api
JWT_EXPIRATION_MINUTES=60

# Orígenes exactos separados por coma. No usar * en producción.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SWAGGER_ENABLED=true

# Bootstrap inicial opcional. Se ejecuta solo sobre una base vacía.
HORABASE_BOOTSTRAP_ENABLED=false
HORABASE_BOOTSTRAP_BUSINESS_NAME=HoraBase Demo
HORABASE_BOOTSTRAP_TAX_ID=219999990019
HORABASE_BOOTSTRAP_ADMIN_DOCUMENT=45678901
HORABASE_BOOTSTRAP_ADMIN_EMAIL=admin@demo.horabase.local
HORABASE_BOOTSTRAP_ADMIN_PASSWORD=AdminDemo123!

ATTENDANCE_SHIFT_MATCH_WINDOW_MINUTES=240
PASSWORD_RESET_EXPIRATION_MINUTES=30
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

MAIL_FROM=no-reply@horabase.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# Perfil usado por Compose. En producción Swagger queda desactivado por defecto.
SPRING_PROFILES_ACTIVE=prod
